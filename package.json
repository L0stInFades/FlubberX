{
  "name": "flubberx",
  "version": "0.5.0",
  "description": "FlubberX: a TypeScript modernization of Flubber for interpolating and animating between 2-D shapes.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "build",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist build && tsup && tsc --emitDeclarationOnly --declaration --declarationMap",
    "test": "pnpm run test:tape && pnpm run test:formal",
    "test:tape": "tsx test/add-test.ts && tsx test/all-test.ts && tsx test/array-test.ts && tsx test/interpolate-test.ts && tsx test/multiple-test.ts && tsx test/normalize-test.ts && tsx test/order-test.ts && tsx test/rotate-test.ts && tsx test/svg-test.ts && tsx test/triangulate-test.ts",
    "test:formal": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/L0stInFades/FlubberX.git"
  },
  "keywords": [
    "shape",
    "morph",
    "tween",
    "svg",
    "animation",
    "triangulation",
    "typescript",
    "sdk"
  ],
  "author": "Noah Veltman (@veltman)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/L0stInFades/FlubberX/issues"
  },
  "homepage": "https://github.com/L0stInFades/FlubberX#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "d3-array": "latest",
    "d3-polygon": "latest",
    "earcut": "latest",
    "svg-path-properties": "latest",
    "svgpath": "latest",
    "topojson-client": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/d3-array": "latest",
    "@types/d3-polygon": "latest",
    "@types/earcut": "latest",
    "@types/node": "latest",
    "@types/tape": "latest",
    "@types/topojson-client": "latest",
    "fast-check": "latest",
    "tape": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
